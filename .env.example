# Autonomous Warehouse Management System - Environment Configuration Template
# COPY TO .env AND POPULATE WITH STRONG RANDOM SECRETS BEFORE RUNNING.
# NEVER COMMIT .env TO SOURCE CONTROL.

# Application Environment (development, testing, production)
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
# Local dev / docker compose connection string
DATABASE_URL=postgresql://warehouse_app:warehouse_dev_pass_placeholder@localhost:5432/warehouse_db

# Security & Cryptography
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_64_CHAR_HEX_KEY
CSRF_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_64_CHAR_HEX_KEY
DEVICE_TOKEN_PEPPER=CHANGE_ME_TO_A_SECURE_RANDOM_PEPPER_KEY

# Session Settings
SESSION_LIFETIME_SECONDS=1800
SESSION_IDLE_TIMEOUT_SECONDS=600
SECURE_COOKIES=false # Set true in TLS/Production target profile

# Operational Simulator Settings
SIMULATOR_TICK_RATE_MS=500
ROBOT_HEARTBEAT_TIMEOUT_SECONDS=30
WAREHOUSE_ID=11111111-1111-1111-1111-111111111111
